# Copy to .env for Docker Compose. Never commit .env.
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
REDIS_PASSWORD=replace-with-a-local-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_TOKEN=replace-with-a-different-32-character-secret

# Migrate-Databases.ps1 writes the following keys after verified migration.
# Do not uncomment placeholders or replace an existing private .env.
# DB_LAYOUT=split
# USER_MYSQL_DATABASE=smart_hotel_user
# USER_MYSQL_USER=sh_user_app
# USER_MYSQL_PASSWORD=<generated-private-value>
# BUSINESS_MYSQL_DATABASE=smart_hotel_business
# BUSINESS_MYSQL_USER=sh_business_app
# BUSINESS_MYSQL_PASSWORD=<different-generated-private-value>

# Hotel migrations end with Split-HotelDatabase.ps1; values below are generated, not manual placeholders.
# HOTEL_MYSQL_DATABASE=smart_hotel_hotel
# HOTEL_MYSQL_USER=sh_hotel_domain
# HOTEL_MYSQL_PASSWORD=<generated-private-value>
# HOTEL_WRITE_OWNER=enabled
# HOTEL_CATALOG_REMOTE=enabled
# HOTEL_DATA_LAYOUT=split

# Run Upgrade-InventoryRemote.ps1 while Java services are stopped. Generated credentials stay local.
# INVENTORY_MODE=remote
# INVENTORY_MYSQL_DATABASE=smart_hotel_inventory
# INVENTORY_MYSQL_USER=sh_inventory_domain
# INVENTORY_MYSQL_PASSWORD=generated-locally

# Split-InventoryDatabase.ps1 adds INVENTORY_DATA_LAYOUT=split after verified migration.

# Split-FullDomains.ps1 generates FULL_DOMAIN_LAYOUT=split and independent role credentials.
# Roles: ORDER, REVIEW, MARKETING, PAYMENT, STAY, STATISTICS; each gets *_MYSQL_DATABASE/USER/PASSWORD.
# BUSINESS_* remains a migration compatibility alias; the order application uses ORDER_* or MYSQL_*.

# External integrations: keep actual values only in ignored .env.
# ALIPAY_ENABLED=true
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_APP_ID=<sandbox-app-id>
# ALIPAY_PRIVATE_KEY_FILE=<absolute-local-app-private-key-file>
# ALIPAY_PUBLIC_KEY_FILE=<absolute-local-alipay-public-key-file>
# ALIPAY_NOTIFY_URL=   # optional for local active-query flow
# ALIPAY_KEY_DIRECTORY=./.run/payment-keys  # container-only read-only key directory
# AI_LLM_ENABLED=true
# AI_LLM_URL=https://api.deepseek.com/chat/completions
# AI_LLM_MODEL=deepseek-flash
# AI_LLM_API_KEY=<private-api-key>
# PAYMENT_MOCK_ENABLED=false  # enable only in an isolated synthetic-data test deployment
